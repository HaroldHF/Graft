# Graft Environment Configuration Template
# Copy to `.env` for local development. NEVER commit `.env` or real credentials.

# --- Control Plane ---
GRAFT_ENV=development
GRAFT_HTTP_ADDR=:8080
GRAFT_LOG_LEVEL=info

# --- PostgreSQL & Redis ---
DATABASE_URL=postgres://graft:graft@localhost:5432/graft?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
GITHUB_TRIGGER_LABEL=graft-fix

# --- LLM Provider (ADR-004: "ollama" uses native /api/chat + num_ctx; "openai" uses /v1/chat/completions) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:14b
LLM_NUM_CTX=8192
LLM_TURN_TIMEOUT_SEC=90

# --- Sandbox & Job Runtime (ADR-002 / FR-02 / FR-05) ---
DOCKER_HOST=
SANDBOX_CPU_CORES=1
SANDBOX_MEMORY_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_MAX_RETRIES=3
JOB_HEARTBEAT_INTERVAL_SEC=30
JOB_STALE_HEARTBEAT_SEC=120
JOB_MAX_TIMEOUT_SEC=1200
